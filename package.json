{
  "name": "tangbao",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/nideyilian/tangbao.git"
  },
  "scripts": {
    "dev": "vite",
    "mock:api": "node scripts/mock-image-api.mjs",
    "build": "tsc -b && npm run typecheck:electron && vite build",
    "typecheck:electron": "tsc -p electron/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"electron/**/*.ts\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"electron/**/*.ts\" \"*.{js,json,md}\"",
    "verify": "tsc -b && npm run typecheck:electron && npm run lint && npm run format:check && npm test",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "vite",
    "electron:build": "vite build && electron-builder",
    "electron:fuses": "node scripts/apply-fuses.mjs",
    "electron:preview": "vite build && electron .",
    "asset:mcp": "vite build && electron . --asset-mcp",
    "release": "vite build && electron-builder --publish always",
    "release:dry": "npm run electron:build -- --publish never",
    "release:check": "node scripts/check-release-health.mjs"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "fflate": "0.8.3",
    "lucide-react": "^1.21.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^2.6.1",
    "zustand": "^5.0.5"
  },
  "overrides": {
    "mdast-util-gfm-autolink-literal": "2.0.0",
    "dompurify": "^3.4.13",
    "js-yaml": "^4.3.1",
    "mermaid": "^11.16.1",
    "nanoid": "^3.3.18",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/react-test-renderer": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "react-test-renderer": "^19.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.3.2",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^4.1.10"
  }
}
