  "font": {
    "size": {
      "$type": "fontSize",
      "xs": { "$value": { "value": 0.75, "unit": "rem" } },
      "sm": { "$value": { "value": 0.8125, "unit": "rem" } },
      "md": { "$value": { "value": 0.875, "unit": "rem" } },
      "lg": { "$value": { "value": 1, "unit": "rem" } },
      "xl": { "$value": { "value": 1.25, "unit": "rem" } },
      "2xl": { "$value": { "value": 1.5, "unit": "rem" } }
    },
    "line-height": {
      "$type": "lineHeight",
      "tight": { "$value": { "value": 1.25, "unit": "rem" } },
      "normal": { "$value": { "value": 1.5, "unit": "rem" } },
      "relaxed": { "$value": { "value": 1.65, "unit": "rem" } }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": "var(--font-ui-sans)" },
      "mono": { "$value": "var(--font-mono)" }
    }
  },
  "shadow": {
    "$type": "shadow",
    "light": {
      "sm": { "$value": "0 1px 2px rgb(0 0 0 / 0.05)" },
      "md": { "$value": "0 8px 24px rgb(15 23 42 / 0.08)" },
      "lg": { "$value": "0 18px 48px rgb(15 23 42 / 0.14)" },
      "focus": { "$value": "0 0 0 3px hsl(218 48% 48% / 0.22)" }
    },
    "dark": {
      "sm": { "$value": "0 1px 2px rgb(0 0 0 / 0.25)" },
      "md": { "$value": "0 10px 28px rgb(0 0 0 / 0.3)" },
      "lg": { "$value": "0 20px 56px rgb(0 0 0 / 0.42)" },
      "focus": { "$value": "0 0 0 3px hsl(216 48% 72% / 0.22)" }
    }
  },
  "control": {
